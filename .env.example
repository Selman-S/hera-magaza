# Sitenin herkese açık adresi (kanonik URL, JSON-LD, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 ise tüm sayfalar noindex (önizleme). Yayında 0 yapılacak.
NEXT_PUBLIC_NOINDEX=1

# PostgreSQL bağlantısı (yerel: hera_dev). Yayında Neon vb.
DATABASE_URL=postgres://hera:SIFRE@localhost:5432/hera_dev
# Entegrasyon testleri için AYRI veritabanı (testler tabloları siler!)
TEST_DATABASE_URL=postgres://hera:SIFRE@localhost:5432/hera_test

# İmzalı çerezler (sipariş görüntüleme, yorum bağlantısı) için en az 32 karakter rastgele değer.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ── Faz 3 entegrasyonları (boş bırakılan servis "mock" modda çalışır) ──
# PayTR (iFrame API) — mağaza panelinden
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1: test modu (varsayılan), 0: canlı
PAYTR_TEST_MODE=1
# 0: PayTR'nin izin verdiği en yüksek taksit, 2–12
PAYTR_MAX_INSTALLMENT=0
# Yayında mock ödeme sayfasını açmak için (yalnızca önizleme!)
PAYMENT_MOCK=

# Trendyol Satıcı API (Hesap Bilgilerim → Entegrasyon Bilgileri)
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# DOĞRULANACAK: storeFrontCode başlık değeri
TRENDYOL_STOREFRONT_CODE=
# 1: stage ortamı
TRENDYOL_STAGE=

# Resend (e-posta) — alan adı doğrulanmış olmalı (SPF/DKIM/DMARC)
RESEND_API_KEY=
EMAIL_FROM=Hera Mağaza <siparis@heramagaza.com.tr>

# Ölçümleme
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Meta panelinde görülen güncel Graph API sürümü (ör. vXX.0)
META_GRAPH_VERSION=
META_TEST_EVENT_CODE=

# Zamanlanmış işler: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
