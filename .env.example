# Sitenin herkese açık adresi (kanonik URL, JSON-LD, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 ise tüm sayfalar noindex (önizleme). Yayında 0 yapılacak.
NEXT_PUBLIC_NOINDEX=1

# PostgreSQL bağlantısı (yerel: hera_dev). Yayında Neon vb.
DATABASE_URL=postgres://hera:SIFRE@localhost:5432/hera_dev
# Entegrasyon testleri için AYRI veritabanı (testler tabloları siler!)
TEST_DATABASE_URL=postgres://hera:SIFRE@localhost:5432/hera_test

# İmzalı çerezler (sipariş görüntüleme, yorum bağlantısı) için en az 32 karakter rastgele değer.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
